# Terraform working directory
.terraform/

# Terraform state — may contain secrets
*.tfstate
*.tfstate.*

# Local variable values
terraform.tfvars
*.tfvars.json

# Saved Terraform plans
tfplan
*.tfplan

# Crash logs
crash.log
crash.*.log

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Function build artifacts
*.zip
.python_packages/
__pycache__/
*.pyc
.venv/